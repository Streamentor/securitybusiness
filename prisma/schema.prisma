// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                   String    @id @default(cuid())
  name                 String
  email                String    @unique
  hashedPassword       String?
  image                String?
  role                 String    @default("user") // user, admin
  plan                 String    @default("free") // free, starter, pro
  credits              Int       @default(1)      // scan credits remaining
  scansUsed            Int       @default(0)
  stripeCustomerId     String?   @unique
  stripeSubscriptionId String?   @unique
  stripePriceId        String?
  currentPeriodEnd     DateTime?
  referrerSource       String?   // e.g. google, taaft, direct, github, youtube, twitter
  referrerUrl          String?   // the full document.referrer URL
  utmSource            String?   // utm_source param
  utmMedium            String?   // utm_medium param
  utmCampaign          String?   // utm_campaign param
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  scans                Scan[]
  githubInstallations  GitHubInstallation[]
  repoScans            RepoScan[]
  aiReviewPreference   AIReviewPreference?
  aiReviewUsage        AIReviewUsage[]
}

model Scan {
  id              String          @id @default(cuid())
  url             String
  status          String          @default("pending") // pending, running, completed, failed
  overallScore    Int?
  totalPages      Int             @default(0)
  pagesScanned    Int             @default(0)
  createdAt       DateTime        @default(now())
  completedAt     DateTime?
  userId          String?
  user            User?           @relation(fields: [userId], references: [id])
  vulnerabilities Vulnerability[]
}

model Vulnerability {
  id          String @id @default(cuid())
  scanId      String
  scan        Scan   @relation(fields: [scanId], references: [id], onDelete: Cascade)
  type        String // ssl, headers, xss, csrf, info-disclosure, outdated-software, etc.
  severity    String // critical, high, medium, low, info
  title       String
  description String
  url         String // The specific page where found
  remedy      String // How to fix it
  createdAt   DateTime @default(now())
}

/// A GitHub App installation the user proved access to (read-only repository contents).
model GitHubInstallation {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  installationId Int
  accountLogin   String
  accountType    String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([userId, installationId])
  @@index([installationId])
}

/// A repository scan that runs in the background and is saved for its owner.
model RepoScan {
  id             String    @id @default(cuid())
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  repository     String // owner/name
  requestedRef   String?
  commitSha      String?
  visibility     String    @default("public") // public, private
  installationId Int?
  status         String    @default("queued") // queued, running, completed, failed
  stage          String?
  score          Int?
  risk           String?
  findingsCount  Int?
  aiModel        String?
  aiInputTokens  Int?
  aiOutputTokens Int?
  aiFindingsCount Int?
  result         Json?
  error          String?
  createdAt      DateTime  @default(now())
  startedAt      DateTime?
  completedAt    DateTime?

  @@index([userId, createdAt])
}

/// Account opt-out; absence of a row uses the disclosed paid-plan default.
model AIReviewPreference {
  userId  String @id
  user    User @relation(fields: [userId], references: [id], onDelete: Cascade)
  enabled Boolean @default(true)
}

/// UTC calendar month. Charged tokens include in-flight/ambiguous reservations.
model AIReviewUsage {
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  month String
  chargedTokens Int @default(0)
  @@id([userId, month])
}
