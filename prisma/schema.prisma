// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                   String    @id @default(cuid())
  name                 String
  email                String    @unique
  hashedPassword       String?
  image                String?
  role                 String    @default("user") // user, admin
  plan                 String    @default("free") // free, starter, pro
  credits              Int       @default(1)      // scan credits remaining
  scansUsed            Int       @default(0)
  stripeCustomerId     String?   @unique
  stripeSubscriptionId String?   @unique
  stripePriceId        String?
  currentPeriodEnd     DateTime?
  referrerSource       String?   // e.g. google, taaft, direct, github, youtube, twitter
  referrerUrl          String?   // the full document.referrer URL
  utmSource            String?   // utm_source param
  utmMedium            String?   // utm_medium param
  utmCampaign          String?   // utm_campaign param
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  scans                Scan[]
  githubInstallations  GitHubInstallation[]
  repoScans            RepoScan[]
  emailConversion EmailConversion?
  emailPreference EmailPreference?
  emailSends EmailSend[]
  emailTests EmailTestSend[] @relation("EmailTestSubject")
  emailTestsAsAdmin EmailTestSend[] @relation("EmailTestAdmin")
  aiReviewPreference   AIReviewPreference?
  aiReviewUsage        AIReviewUsage[]
}

model Scan {
  id              String          @id @default(cuid())
  url             String
  status          String          @default("pending") // pending, running, completed, failed
  overallScore    Int?
  totalPages      Int             @default(0)
  pagesScanned    Int             @default(0)
  createdAt       DateTime        @default(now())
  completedAt     DateTime?
  userId          String?
  user            User?           @relation(fields: [userId], references: [id])
  vulnerabilities Vulnerability[]
  reportAccess WebsiteReportAccess?
}

model Vulnerability {
  id          String @id @default(cuid())
  scanId      String
  scan        Scan   @relation(fields: [scanId], references: [id], onDelete: Cascade)
  type        String // ssl, headers, xss, csrf, info-disclosure, outdated-software, etc.
  severity    String // critical, high, medium, low, info
  title       String
  description String
  url         String // The specific page where found
  remedy      String // How to fix it
  createdAt   DateTime @default(now())
}

/// A GitHub App installation the user proved access to (read-only repository contents).
model GitHubInstallation {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  installationId Int
  accountLogin   String
  accountType    String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([userId, installationId])
  @@index([installationId])
}

/// A repository scan that runs in the background and is saved for its owner.
model RepoScan {
  id             String    @id @default(cuid())
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  repository     String // owner/name
  requestedRef   String?
  commitSha      String?
  visibility     String    @default("public") // public, private
  installationId Int?
  status         String    @default("queued") // queued, running, completed, failed
  stage          String?
  score          Int?
  risk           String?
  findingsCount  Int?
  aiModel        String?
  aiInputTokens  Int?
  aiOutputTokens Int?
  aiFindingsCount Int?
  result         Json?
  error          String?
  createdAt      DateTime  @default(now())
  startedAt      DateTime?
  completedAt    DateTime?

  @@index([userId, createdAt])
}

/// Account opt-out; absence of a row uses the disclosed paid-plan default.
model AIReviewPreference {
  userId  String @id
  user    User @relation(fields: [userId], references: [id], onDelete: Cascade)
  enabled Boolean @default(true)
}

/// UTC calendar month. Charged tokens include in-flight/ambiguous reservations.
model AIReviewUsage {
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  month String
  chargedTokens Int @default(0)
  @@id([userId, month])
}

/// Recurring invoice fulfillment is idempotent across webhook Event IDs.
model InvoiceCreditGrant {
  invoiceId String @id
  subscriptionId String
  createdAt DateTime @default(now())
}

/// Only hashes of browser creator proofs and revocable sharing capabilities persist.
model WebsiteReportAccess {
  scanId String @id
  scan Scan @relation(fields: [scanId], references: [id], onDelete: Cascade)
  creatorHash String?
  shareHash String?
}

model EmailPreference {
  userId String @id
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  marketingOptOut Boolean @default(false)
  optOutAt DateTime?
  suppressed Boolean @default(false)
  suppressedReason String?
  consentAt DateTime?
  lastSequenceCheckAt DateTime?
  updatedAt DateTime @default(now()) @updatedAt
}
model EmailSend {
  id String @id
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  emailKey String
  sesMessageId String? @unique
  status String
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
  @@unique([userId, emailKey])
  @@index([createdAt])
}
model EmailEvent {
  id String @id
  sendId String?
  eventType String
  createdAt DateTime @default(now())
}
model EmailTestSend {
  id String @id
  adminId String
  admin User @relation("EmailTestAdmin", fields: [adminId], references: [id], onDelete: Cascade)
  userId String
  user User @relation("EmailTestSubject", fields: [userId], references: [id], onDelete: Cascade)
  emailKey String
  mode String
  sesMessageId String?
  status String
  createdAt DateTime @default(now())
}

model EmailConversion {
  userId String @id
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  checkoutId String @unique
  emailKey String
  sendId String
  paidAt DateTime
}

model EmailSequenceRun {
  id String @id
  mode String
  status String
  startedAt DateTime
  completedAt DateTime
  examined Int @default(0)
  sent Int @default(0)
  @@index([startedAt])
}

// Runtime DDL lives in scan-funnel.ts. No migration history is introduced.
model ScanFunnel {
  scanId           String    @id
  signupClickedAt  DateTime?
  registeredAt     DateTime?
  registeredUserId String?
  claimedAt        DateTime?
  upgradedAt       DateTime?
}

model ScanFunnelRollout {
  id        Int      @id
  startedAt DateTime @default(now())
}
