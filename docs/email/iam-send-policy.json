{
  "Version": "2012-10-17",
  "Statement": [{
    "Sid": "ScanMySaaSSendingOnly",
    "Effect": "Allow",
    "Action": ["ses:SendEmail", "ses:SendRawEmail"],
    "Resource": [
      "arn:aws:ses:eu-central-1:ACCOUNT_ID:identity/scanmysaas.com",
      "arn:aws:ses:eu-central-1:ACCOUNT_ID:configuration-set/scanmysaas-onboarding"
    ],
    "Condition": {"StringEquals": {"ses:FromAddress": "stefan@scanmysaas.com"}}
  }]
}
